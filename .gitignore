# Données réelles : jamais versionnées
data/raw/*
!data/raw/.gitkeep

# Journaux, cache d'embeddings et pipelines sauvegardés
logs/
cache/
artifacts/

# Rapports générés
reports/*
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Secrets (clés Azure à venir)
.env
