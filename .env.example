# Copier ce fichier en .env (jamais versionné) et le compléter avec vos informations Azure OpenAI.
# Endpoint et clé : page « Clés et point de terminaison » de votre ressource Azure OpenAI.
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Version d'API indiquée dans Azure AI Foundry pour vos déploiements.
AZURE_OPENAI_API_VERSION=
# Nom exact de votre déploiement d'embeddings (doit aussi figurer dans config/pricing.yaml, section deployments).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
