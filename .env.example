# Copy this file to .env (never committed) and fill it in with your Azure OpenAI details.
# Endpoint and key: "Keys and Endpoint" page of your Azure OpenAI resource.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# API version shown in Azure AI Foundry for your deployments.
AZURE_OPENAI_API_VERSION=
# Exact name of your embeddings deployment (it must also appear in config/pricing.yaml, deployments section).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
